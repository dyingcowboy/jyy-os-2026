%!PS-Adobe-3.0
%%BoundingBox: 0 0 400 500
%%Title: Fractal Sunset — PostScript Demo
%%Creator: Claude Code

% ============================================================
%  SKY GRADIENT  —  dark purple → sunset orange
% ============================================================
% Top (y=0):    r=0.04 g=0.02 b=0.25  (deep night)
% Horizon:      r=0.95 g=0.45 b=0.08  (warm orange)

0 2 298 {
    /yi exch def
    /t yi 300 div def

    /r t 0.91 mul 0.04 add def
    /g t 0.43 mul 0.02 add def
    /b 1 t sub 0.17 mul 0.08 add def

    r g b setrgbcolor
    newpath
    0 yi moveto  400 yi lineto
    1 setlinewidth stroke
} for

% Soft gradient overlay near horizon
0.98 0.65 0.15 setrgbcolor
newpath
0 270 moveto 400 270 lineto 400 300 lineto 0 300 lineto closepath
0.2 setgray  % Won't work for transparency, just use a lighter band
fill

% Horizon glow
0.97 0.70 0.20 setrgbcolor
newpath
0 280 moveto 400 280 lineto 400 300 lineto 0 300 lineto closepath fill

% ============================================================
%  STARS  —  scattered white dots in the dark upper sky
% ============================================================
1 1 1 setrgbcolor
[
  [30 25] [65 15] [100 35] [140 20] [175 12] [210 28] [250 18]
  [290 10] [330 22] [365 30] [50 50] [115 45] [190 8] [270 40]
  [350 15] [80 35] [155 5] [235 38] [310 12] [380 22]
  [45 60] [125 55] [200 48] [285 52] [340 42]
] {
    aload pop
    newpath
    1.2 0 360 arc fill
} forall

% A few brighter stars with crosses
[
  [140 18] [250 16] [50 48] [330 20]
] {
    aload pop
    /sy exch def /sx exch def
    newpath
    sx sy 2 0 360 arc fill
    newpath
    sx 4 sub sy moveto sx 4 add sy lineto stroke
    newpath
    sx sy 4 sub moveto sx sy 4 add lineto stroke
} forall

% ============================================================
%  SUN  —  low on the horizon
% ============================================================
% Outer glow
1 0.78 0.10 setrgbcolor
newpath
200 170 55 0 360 arc fill

% Mid glow
1 0.88 0.25 setrgbcolor
newpath
200 170 42 0 360 arc fill

% Core
1 0.97 0.55 setrgbcolor
newpath
200 170 30 0 360 arc fill

% ============================================================
%  DISTANT MOUNTAINS  —  silhouette on the horizon
% ============================================================
0.35 0.25 0.45 setrgbcolor
newpath
0 300 moveto
50 300 lineto
80 275 lineto
120 290 lineto
160 265 lineto
210 285 lineto
260 270 lineto
310 280 lineto
350 260 lineto
400 275 lineto
400 300 lineto
closepath fill

% ============================================================
%  GROUND
% ============================================================
0.06 0.28 0.06 setrgbcolor
newpath
0 300 moveto 400 300 lineto 400 500 lineto 0 500 lineto closepath fill

% Ground highlight near horizon
0.09 0.33 0.09 setrgbcolor
newpath
0 300 moveto 400 300 lineto 400 312 lineto 0 312 lineto closepath fill

% ============================================================
%  FRACTAL TREE  —  recursive beauty
% ============================================================
% Tree procedure:
%   stack:  x  y  length  angle  depth
%   depth 0: draw leaf,     depth > 0: draw branch + recurse
/Tree {
    /depth exch def
    /angle exch def
    /len  exch def
    /y    exch def
    /x    exch def

    depth 0 le {
        % ---- LEAF ----
        gsave
        0.02 0.45 0.05 setrgbcolor
        newpath
        x y 3.2 0 360 arc fill
        grestore
    } {
        % ---- BRANCH ----
        /newx x angle cos len mul add def
        /newy y angle sin len mul add def

        % Vary branch color: thick=dark brown, thin=lighter
        /t depth 8 div def
        /br 0.35 t 0.02 mul sub def
        /bg 0.20 t 0.08 mul add def
        /bb 0.06 t 0.01 mul add def

        gsave
        br bg bb setrgbcolor
        depth 0.3 mul 0.4 add setlinewidth
        1 setlinecap
        newpath
        x y moveto newx newy lineto stroke
        grestore

        % Left branch  —  shallower angle
        newx newy len 0.73 mul angle 28 add depth 1 sub Tree

        % Right branch  —  symmetrical
        newx newy len 0.73 mul angle 28 sub depth 1 sub Tree
    } ifelse
} def

% Main tree — center foreground
200 300 80 90 9 Tree

% Small companion tree — right side
330 305 45 93 6 Tree

% Tiny tree — left side
65 305 30 95 5 Tree

% ============================================================
%  GRASS TUFTS
% ============================================================
0.05 0.45 0.05 setrgbcolor
1 setlinewidth  1 setlinecap

% Scattered grass along the ground
[  [25 300] [40 300] [70 300] [90 300] [120 300]
   [150 300] [180 300] [220 300] [240 300] [260 300]
   [290 300] [310 300] [350 300] [370 300] [385 300]  ]
{
    aload pop
    /gy exch def /gx exch def
    newpath gx gy moveto gx 3 sub gy 10 sub lineto stroke
    newpath gx gy moveto gx 1 add gy 12 sub lineto stroke
    newpath gx gy moveto gx 3 add gy 8 sub lineto stroke
} forall

% ============================================================
%  BIRDS  —  little V-shapes in the sky
% ============================================================
/Bird {
    /yscale exch def
    /xscale exch def
    /y exch def
    /x exch def

    0.15 0.12 0.18 setrgbcolor
    0.6 setlinewidth  1 setlinecap
    newpath
    x 10 xscale mul sub  y  8 yscale mul add  moveto
    x                     y                    lineto
    x 10 xscale mul add  y  8 yscale mul add  lineto
    stroke
} def

70 110 1.6 1.3 Bird
110 75  1.2 1.0 Bird
145 95  1.4 1.1 Bird
280 115 1.0 0.8 Bird
320 85  1.3 1.0 Bird
50  140 1.5 1.2 Bird

% ============================================================
%  FLOWERS  —  small dots of colour on the ground
% ============================================================
[
  [60 370 0.9 0.2 0.3]  [100 390 1 0.75 0.1]  [155 380 1 0.85 0.2]
  [230 395 0.95 0.3 0.4]  [280 375 1 0.9 0.15]  [340 385 0.85 0.2 0.5]
  [180 410 0.9 0.2 0.35] [300 415 1 0.8 0.1]   [120 400 0.95 0.25 0.45]
] {
    aload pop
    /fb exch def /fg exch def /fr exch def /fy exch def /fx exch def
    fr fg fb setrgbcolor
    newpath fx fy 3 0 360 arc fill
    % Stem
    0.05 0.4 0.05 setrgbcolor
    0.5 setlinewidth
    newpath fx fy moveto fx 1 add fy 8 add lineto stroke
} forall

% ============================================================
%  TITLE  —  centre-bottom
% ============================================================
/Times-Bold findfont 28 scalefont setfont
0 0 0 setrgbcolor
200 470 moveto
(POSTSCRIPT) dup stringwidth pop 2 div neg 0 rmoveto show

/Times-Italic findfont 13 scalefont setfont
0.2 0.15 0.15 setrgbcolor
200 450 moveto
(a stack-machine love story) dup stringwidth pop 2 div neg 0 rmoveto show

% ============================================================
%  BORDER  —  clean frame
% ============================================================
0.05 0.05 0.08 setrgbcolor
2.5 setlinewidth  1 setlinejoin
newpath
6 6 moveto  394 6 lineto  394 494 lineto  6 494 lineto  closepath stroke

showpage
%%EOF
